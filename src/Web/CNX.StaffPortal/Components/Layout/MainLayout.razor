@inherits LayoutComponentBase

<div style="display:flex; min-height:100vh;">
    @* ── SIDEBAR ── *@
    <aside class="cnx-sidebar">
        <div class="cnx-sidebar-logo">CNX</div>
        <nav style="padding:8px 0;">
            <div class="cnx-menu-group">QUẢN TRỊ</div>
            <NavLink class="cnx-menu-item" href="/" Match="NavLinkMatch.All">
                <RadzenIcon Icon="dashboard" /> Dashboard
            </NavLink>
            <NavLink class="cnx-menu-item" href="/tenants">
                <RadzenIcon Icon="business" /> Khách hàng
            </NavLink>

            <div class="cnx-menu-group">NGHIỆP VỤ</div>
            <NavLink class="cnx-menu-item" href="/accounting">
                <RadzenIcon Icon="account_balance" /> Kế toán
            </NavLink>
            <NavLink class="cnx-menu-item" href="/inventory">
                <RadzenIcon Icon="inventory_2" /> Kho
            </NavLink>
            <NavLink class="cnx-menu-item" href="/production">
                <RadzenIcon Icon="precision_manufacturing" /> Sản xuất
            </NavLink>
            <NavLink class="cnx-menu-item" href="/tax">
                <RadzenIcon Icon="receipt_long" /> Thuế
            </NavLink>
        </nav>
    </aside>

    @* ── MAIN AREA ── *@
    <div class="cnx-content" style="flex:1;">
        <header class="cnx-header">
            <span style="font-size:14px; color:var(--cnx-text-secondary);">CNX Staff Portal</span>
            <span style="font-size:14px; color:var(--cnx-text-secondary);">👤 Admin</span>
        </header>
        <div style="padding:24px;">
            @Body
        </div>
    </div>
</div>

<RadzenDialog />
<RadzenNotification />
<RadzenTooltip />
<RadzenContextMenu />

<div id="blazor-error-ui" style="display:none;">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
