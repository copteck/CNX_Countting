@page "/"

<PageTitle>CNX Staff Portal</PageTitle>

<RadzenStack Gap="1.5rem" class="rz-p-4">
    <div class="cnx-header rz-p-4" style="border-radius:12px;">
        <RadzenText TextStyle="TextStyle.H4" class="rz-color-white rz-mb-0">
            CNX Portal Nhân viên
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-color-white">
            Quản trị số liệu kế toán đa khách hàng
        </RadzenText>
    </div>

    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMd="3">
            <RadzenCard class="cnx-card">
                <RadzenText TextStyle="TextStyle.Overline">Khách hàng</RadzenText>
                <RadzenText TextStyle="TextStyle.H4">--</RadzenText>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMd="3">
            <RadzenCard class="cnx-card">
                <RadzenText TextStyle="TextStyle.Overline">Bút toán</RadzenText>
                <RadzenText TextStyle="TextStyle.H4">--</RadzenText>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMd="3">
            <RadzenCard class="cnx-card">
                <RadzenText TextStyle="TextStyle.Overline">Hóa đơn</RadzenText>
                <RadzenText TextStyle="TextStyle.H4">--</RadzenText>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMd="3">
            <RadzenCard class="cnx-card">
                <RadzenText TextStyle="TextStyle.Overline">Báo cáo thuế chờ duyệt</RadzenText>
                <RadzenText TextStyle="TextStyle.H4">--</RadzenText>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>
