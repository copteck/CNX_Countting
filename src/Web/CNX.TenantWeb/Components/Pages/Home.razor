@page "/"

<PageTitle>CNX - Cổng khách hàng</PageTitle>

<RadzenStack Gap="1.5rem" class="rz-p-4">
    <div class="cnx-header rz-p-4" style="border-radius:12px;">
        <RadzenText TextStyle="TextStyle.H4" class="rz-color-white rz-mb-0">
            Cổng thông tin khách hàng
        </RadzenText>
        <RadzenText TextStyle="TextStyle.Subtitle1" class="rz-color-white">
            Theo dõi số liệu kế toán của doanh nghiệp bạn
        </RadzenText>
    </div>

    <RadzenRow Gap="1rem">
        <RadzenColumn Size="12" SizeMd="@(4)">
            <RadzenCard class="cnx-card">
                <RadzenText TextStyle="TextStyle.Overline">Doanh thu kỳ này</RadzenText>
                <RadzenText TextStyle="TextStyle.H4">--</RadzenText>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMd="@(4)">
            <RadzenCard class="cnx-card">
                <RadzenText TextStyle="TextStyle.Overline">Chi phí kỳ này</RadzenText>
                <RadzenText TextStyle="TextStyle.H4">--</RadzenText>
            </RadzenCard>
        </RadzenColumn>
        <RadzenColumn Size="12" SizeMd="@(4)">
            <RadzenCard class="cnx-card">
                <RadzenText TextStyle="TextStyle.Overline">Tồn kho</RadzenText>
                <RadzenText TextStyle="TextStyle.H4">--</RadzenText>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</RadzenStack>
